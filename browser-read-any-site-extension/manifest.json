{
  "manifest_version": 3,
  "name": "Browser Read Any Site",
  "version": "1.3.30",
  "description": "Browser Read com acesso restrito por conteúdo e suporte ao SSO da Hotmart no Claude Code Architect.",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "declarativeNetRequest",
    "management"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Browser Read Any Site"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "zoom-client.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.zoom.us/wc/*"
      ],
      "js": [
        "zoom-client-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "externally_connectable": {
    "ids": [
      "opebpmbhihaffdfogpeimddbpjhhejpk"
    ]
  }
}
