{
  "manifest_version": 3,
  "name": "Browser Read Any Site",
  "version": "1.3.72",
  "description": "Corrige a corrida do tabs.onCreated no Combo, aguardando combo-launch.html antes de aplicar escopo e mantendo diagnÃ³stico por aba.",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "declarativeNetRequest",
    "management",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Browser Read Any Site"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "zoom-client.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.zoom.us/wc/*"
      ],
      "js": [
        "zoom-client-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "externally_connectable": {
    "ids": [
      "*"
    ]
  }
}