{
  "manifest_version": 3,
  "name": "Browser Read Any Site - Instancia 2",
  "version": "1.0.0",
  "description": "Extensao minima com permissao de leitura em qualquer site.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Browser Read Any Site - Instancia 2"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
